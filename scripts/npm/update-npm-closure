#!/usr/bin/env python3
"""TL npm closure updater: per-package compliance OCI + global closure index.

Schema v3 (assess writes initial doc; updater mutates gap lists + level only):

  direct_dependencies  immutable [{name, requested}] from package.json
  missing_gaps         mutable [name@version, ...] not on TL yet
  pending_l3_gaps      mutable [name@version, ...] on TL but not L3
  compliance_level     L1 if missing_gaps; L2 if pending_l3_gaps; else L3

Global index (separate OCI artifact): blocker name@version -> {parents: [...]}.

Pulp labels (tl.compliance_level, tl.compliance_oci_digest) use the OCI digest
as an optimistic lock: write digest first and re-read; only then write level
(after another re-read for sticky max). If another digest is present, fail
closed so the release can be retried. Levels are sticky (never downgraded).

Usage:
  update-npm-closure update --sidecar PATH [--pulp-href HREF]
  update-npm-closure seed [--init-index]
  update-npm-closure rebalance [--index-only]
  update-npm-closure show --name NAME --version VERSION
  update-npm-closure show-index

Environment (Pulp REST):
  PULP_BASE_URL, PULP_API_ROOT, PULP_DOMAIN, PULP_REPOSITORY
  SECRET_DIR or PULP_USERNAME + PULP_PASSWORD
  TL_NPM_REGISTRY_URL

Environment (Quay / ORAS — prefixes required at deploy time, never hardcoded):
  COMPLIANCE_IMAGE_PREFIX   required
  CLOSURE_INDEX_IMAGE       optional; default: ${COMPLIANCE_IMAGE_PREFIX}/npm-closure-index:latest
  COMPLIANCE_ARTIFACT_TYPE, ORAS_OPTIONS
"""
from __future__ import print_function

